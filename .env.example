# Conduit Console — environment reference. Copy to .env and fill in.
# Placeholders only: never commit a real key. The app reads these from the
# process environment; nothing is configurable in the browser (plan v2 §2).
#
# SECRETS FROM FILES: every secret-bearing setting below also accepts a path
# instead of a value — CONDUIT_API_KEY_FILE, SESSION_SECRET_FILE,
# ENCRYPTION_KEY_FILE, PROXY_SHARED_SECRET_FILE, CONDUIT_WEBHOOK_SECRET_FILE,
# OIDC_CLIENT_SECRET_FILE, DATABASE_URL_FILE — which is how Docker secrets and
# Kubernetes projected volumes deliver them. One trailing newline is stripped.
# Setting both FOO and FOO_FILE is refused at startup (deploy/README §2).

# --- Conduit connection -------------------------------------------------------
# sandbox | staging | production — selects the hardcoded host allowlist entry:
#   sandbox    https://api.sandbox.conduit.financial
#   staging    https://api.staging.conduit.financial
#   production https://api.conduit.financial
CONDUIT_ENV=sandbox
# API key for that environment, one Conduit organization per installation.
CONDUIT_API_KEY=
# Optional. Must equal the allowlisted origin for CONDUIT_ENV or the app refuses
# to start; anything else is rejected. Normally leave unset.
#CONDUIT_API_BASE=https://api.sandbox.conduit.financial
# Signing secret of this installation's webhook endpoint, returned once by
# POST /v2/webhooks/endpoints (and again on each rotation). Copy it VERBATIM,
# `whsec_` prefix included — the prefix is part of the HMAC key, and stripping
# it makes every valid delivery look tampered with. Unset (the default) means no
# endpoint is registered yet and POST /webhooks/conduit is not mounted at all.
#CONDUIT_WEBHOOK_SECRET=          # whsec_ + 64 hex, exactly as Conduit issued it

# --- Database -----------------------------------------------------------------
# Same URL serves the async app and Alembic migrations.
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/conduit_console

# --- Security -----------------------------------------------------------------
# proxy (default) | oidc | disabled. `disabled` is development only — the app
# refuses to start with AUTH_MODE=disabled outside CONDUIT_ENV=sandbox (staging
# carries a live key against a host that self-labels "Production").
AUTH_MODE=proxy
# Per-operation money ceiling, a decimal string. Empty (the default) = no
# ceiling. When set, every money mutation — payout, transfer, each batch row,
# the batch total, a conversion order's source amount — is refused locally,
# before the operations ledger sees it, and the number is shown beside the host
# on the environment strip. Set this for a production validation run; see
# deploy/README.md "Validation runs". Per operation, NOT per day.
#MONEY_CEILING=25.00
# Session cookie signing secret. LEAVE BLANK HERE and generate a real one:
#   openssl rand -hex 32
# Outside CONDUIT_ENV=sandbox the app refuses to start on a secret shorter than
# 32 characters or containing placeholder text — a copied example file must
# never be able to sign an admin session.
SESSION_SECRET=
# Session lifetime, and the cookie flags. Cookies are always HttpOnly +
# SameSite=Lax, and carry the `__Host-` prefix whenever COOKIE_SECURE is on, so
# no sibling subdomain can plant one. COOKIE_SECURE=false is accepted ONLY with
# CONDUIT_ENV=sandbox — anywhere else the app refuses to start.
#SESSION_MAX_AGE_SECONDS=43200
#COOKIE_SECURE=true

# --- AUTH_MODE=proxy ----------------------------------------------------------
# Identity headers are trusted ONLY on requests that also carry the shared
# secret below — set the same value on the auth proxy (e.g. oauth2-proxy
# --set-xauthrequest plus a static injected header) and keep the app port off
# the public network. Without it every request is refused. Generate as above;
# blank here on purpose, and a placeholder value is refused outside sandbox.
PROXY_SHARED_SECRET=
#PROXY_SECRET_HEADER=X-Proxy-Auth
#PROXY_USER_HEADER=X-Auth-Request-User
#PROXY_EMAIL_HEADER=X-Auth-Request-Email
#PROXY_GROUPS_HEADER=X-Auth-Request-Groups

# --- AUTH_MODE=oidc -----------------------------------------------------------
# Authorization-code flow with PKCE (S256) against a discovery-capable issuer
# (RS256 ID tokens). The issuer — and every endpoint its discovery document
# names — must be https, except a loopback address for local development.
#OIDC_ISSUER=https://idp.example.com
#OIDC_CLIENT_ID=conduit-console
#OIDC_CLIENT_SECRET=            # 32+ chars outside sandbox; never a placeholder
#OIDC_CALLBACK_PATH=/auth/callback     # register this path with the IdP
# Absolute callback URL, sent verbatim on the authorization redirect and the
# token exchange. SET THIS IN ANY DEPLOYMENT BEHIND A TLS-TERMINATING PROXY:
# unset, it is derived from the request's own base URL, which is http:// unless
# forwarded headers are trusted. Required (and must be https) when
# CONDUIT_ENV=production.
#OIDC_REDIRECT_URI=https://console.example.com/auth/callback
#OIDC_ROLE_CLAIM=roles
#OIDC_SCOPES=openid email profile

# --- Roles --------------------------------------------------------------------
# Proxy group / OIDC role-claim values -> console roles (viewer < operator <
# admin). A value not listed here maps to the role of the same name; anything
# else grants nothing, and a user with no role gets a 403 page.
#AUTH_ROLE_MAP=conduit-ops=operator,conduit-admins=admin
# Custom roles, as a JSON file of {"role name": ["permission", ...]}. The three
# built-in roles are always available and cannot be redefined; a role here is
# mapped from a group by AUTH_ROLE_MAP like any other. Every permission name is
# in PERMISSIONS.md — an unknown one, or a role missing the reads its writes
# need, refuses to start.
#ROLES_FILE=/etc/conduit-console/roles.json
# Fernet keys for encrypted request bodies and drafts, comma-separated,
# NEWEST FIRST: the first key encrypts, every listed key decrypts. Rotate by
# prepending a new key and redeploying; drop the old one once retention has
# aged out the rows it wrote. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=replace-me-with-a-generated-fernet-key

# --- Operations engine (OPERATIONS_SPEC §6; defaults shown) -------------------
#OP_CLIENT_TIMEOUT=30            # seconds per Conduit call
#OP_STALE_INFLIGHT_FACTOR=2      # in_flight older than timeout × this = stale
#OP_CREATED_TTL_SECONDS=86400    # never-sent operations -> abandoned
#OP_BODY_RETENTION_DAYS=30       # purge request_body, document blobs + finished batches' destinations
#WEBHOOK_RAW_RETENTION_DAYS=30   # purge a delivery's raw_body once processed (never if failed)
#DRAFT_TTL_DAYS=30               # unsubmitted drafts discarded after this long untouched
#RECONCILE_MAX_ATTEMPTS=5        # then the operation is stalled
#RECONCILE_INTERVAL_SECONDS=60   # worker sweep interval
#PROJECTION_STALE_SECONDS=900    # re-read a non-terminal projection untouched for longer
#RECONCILE_REQUEST_BUDGET=100    # Conduit requests one reconciler pass may spend

# --- Worker liveness (deploy/README §4) ---------------------------------------
# A file the worker touches after every successful loop pass; a container
# healthcheck stats it (stale by more than 3× the reconcile interval = the loops
# are not running). Unset writes nothing.
#WORKER_HEARTBEAT_PATH=/tmp/worker.heartbeat
# Consecutive failed passes of one loop before the worker exits non-zero, so the
# restart policy acts instead of a queue growing behind a live-but-idle process.
# One successful pass resets the count.
#WORKER_MAX_FAILED_PASSES=10

# --- Container entrypoint (docker-entrypoint.sh, not app/config.py) -----------
# Port the `web` command binds, inside the container.
#PORT=8000
# 1 runs `alembic upgrade head` before either role starts. Prefer a one-shot
# migration container when more than one replica starts at once — see
# deploy/README.md §4.
#RUN_MIGRATIONS=0

# --- Conduit client read policy (plan v2 §4; defaults shown) ------------------
# GETs retry on 429 (honoring Retry-After), 5xx and transport errors.
# Mutations are NEVER retried — an ambiguous one becomes outcome_unknown.
#READ_MAX_ATTEMPTS=4
#READ_BACKOFF_BASE_SECONDS=0.25
#READ_BACKOFF_MAX_SECONDS=8
